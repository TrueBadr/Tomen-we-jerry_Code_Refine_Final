    {
      "id": "mDwhFkB4T0PjacVcXkWqv",
      "type": "text",
      "x": 550.9334379567352,
      "y": 1748.7274445336163,
      "width": 1520.5189208984375,
      "height": 600,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "a8",
      "roundness": null,
      "seed": 683102700,
      "version": 2041,
      "versionNonce": 859284587,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1790081257298,
      "created": 1790072884013,
      "link": null,
      "locked": false,
      "text": "functional requirements:\n    1-Customers can search products\n    2-Customers can add the products and quantities to the cart\n    3-customer can track their order from the moment it placed ((Placed → Confirmed → Picking → Packed → Shipped → Out for Delivery → Delivered)\n    4-system receives orderes\n    5-system sends notifications to the customers can review the status of the order whenever the order status changed\n    6- the system can notify operators about the important events like (robot failure / delayed order / robot with low battery)\n    7-when order is confirmed the system decide how many robots to collect the products in the confirmed order based on number of items and the weights\n    8-wharehous operators can view the order status \n    9-system must handle robot breakdown\n\nnon-functional:\n\n    1- the system must have the concept of idempotency ( makes sure the same order is never processed twice, even if it is submitted more than once.)\n    2-the system must have the ability of saving thousands products\n    3-the system must ensure the product availability (when customer order a product system check if it there?)\n    4-the system must handle the click first problem approach make the poriority for the first client click the order button within the timing of transaction\n    5-the system must have the ability for scaling to billions of users and requests\n    6-the products may be shown within less than 2s not greater than 2s\n    7-the order operation must be low latency les than 20ms\n    8-fully following of robots status for awareness \n\n\n",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "functional requirements:\n    1-Customers can search products\n    2-Customers can add the products and quantities to the cart\n    3-customer can track their order from the moment it placed ((Placed → Confirmed → Picking → Packed → Shipped → Out for Delivery → Delivered)\n    4-system receives orderes\n    5-system sends notifications to the customers can review the status of the order whenever the order status changed\n    6- the system can notify operators about the important events like (robot failure / delayed order / robot with low battery)\n    7-when order is confirmed the system decide how many robots to collect the products in the confirmed order based on number of items and the weights\n    8-wharehous operators can view the order status \n    9-system must handle robot breakdown\n\nnon-functional:\n\n    1- the system must have the concept of idempotency ( makes sure the same order is never processed twice, even if it is submitted more than once.)\n    2-the system must have the ability of saving thousands products\n    3-the system must ensure the product availability (when customer order a product system check if it there?)\n    4-the system must handle the click first problem approach make the poriority for the first client click the order button within the timing of transaction\n    5-the system must have the ability for scaling to billions of users and requests\n    6-the products may be shown within less than 2s not greater than 2s\n    7-the order operation must be low latency les than 20ms\n    8-fully following of robots status for awareness \n\n\n",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
